{% comment %}
  Replies, reposts, and likes are the counts on each post's tweet.
  X does not publish a share total, so shares are estimated from that reach.
{% endcomment %}
{% assign tweet_replies = post.engagement.replies %}
{% assign tweet_retweets = post.engagement.retweets %}
{% assign tweet_likes = post.engagement.likes %}
{% assign tweet_shares = post.engagement.shares %}
<div class="tweet-actions">
  <span class="tweet-action">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.4 8.4 0 0 1-8.4 8.4c-1.3 0-2.5-.3-3.6-.8L3 21l1.9-5.6A8.4 8.4 0 1 1 21 11.5z"></path>
    </svg>
    {% include tweet_count.liquid count=tweet_replies label="replies" %}
  </span>
  <span class="tweet-action">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M17 2l4 4-4 4"></path>
      <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
      <path d="M7 22l-4-4 4-4"></path>
      <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
    </svg>
    {% include tweet_count.liquid count=tweet_retweets label="retweets" %}
  </span>
  <span class="tweet-action">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3.2l2.6 5.5 6 .8-4.4 4.1 1.1 6L12 16.8 6.7 19.6l1.1-6L3.4 9.5l6-.8L12 3.2z"></path>
    </svg>
    {% include tweet_count.liquid count=tweet_likes label="likes" %}
  </span>
  <span class="tweet-action">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 16V4"></path>
      <path d="M7.5 8.5L12 4l4.5 4.5"></path>
      <path d="M5 14.5V19a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4.5"></path>
    </svg>
    {% include tweet_count.liquid count=tweet_shares label="shares" %}
  </span>
</div>
