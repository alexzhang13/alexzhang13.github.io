<ul class="plate-links">
  {% for link in include.links %}
    <li>
      <a
        class="plate-link plate-link-{{ link.kind }}"
        href="{{ link.url }}"
        target="_blank"
        rel="noopener"
        {% if link.kind == "arxiv" %}
          aria-label="arXiv paper {{ link.label }}"
        {% elsif link.kind == "neurips" %}
          aria-label="NeurIPS 2026 poster"
        {% elsif link.kind == "github" %}
          aria-label="GitHub repository {{ link.label }}"
        {% elsif link.kind == "x" %}
          aria-label="X announcement"
        {% else %}
          aria-label="{{ link.label | escape }}"
        {% endif %}
      >
        {% if link.kind == "arxiv" %}
          <span class="arxiv-mark" aria-hidden="true">ar<span>X</span>iv</span>
          <span class="plate-link-id">{{ link.label }}</span>
        {% elsif link.kind == "neurips" %}
          <i class="ti ti-presentation" aria-hidden="true"></i>
          <span>{{ link.label }}</span>
        {% elsif link.kind == "github" %}
          <i class="fa-brands fa-github" aria-hidden="true"></i>
          <span>{{ link.label }}</span>
        {% elsif link.kind == "x" %}
          <i class="fa-brands fa-square-x-twitter" aria-hidden="true"></i>
        {% else %}
          <span>{{ link.label }}</span>
        {% endif %}
      </a>
    </li>
  {% endfor %}
</ul>
