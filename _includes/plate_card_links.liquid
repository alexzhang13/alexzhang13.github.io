<ul class="plate-links">
  {% for link in include.links %}
    <li>
      <a
        class="plate-link plate-link-{{ link.kind }}"
        href="{{ link.url }}"
        target="_blank"
        rel="noopener"
        {% if link.kind == "arxiv" %}
          aria-label="arXiv paper {{ link.label }}"
        {% elsif link.kind == "neurips" %}
          aria-label="NeurIPS 2026 poster"
        {% elsif link.kind == "github" %}
          aria-label="GitHub repository {{ link.label }}"
        {% elsif link.kind == "x" %}
          aria-label="X announcement"
        {% else %}
          aria-label="{{ link.label | escape }}"
        {% endif %}
      >
        {% if link.kind == "arxiv" %}
          <span class="arxiv-mark" aria-hidden="true">ar<span>X</span>iv</span>
          <span class="plate-link-id">{{ link.label }}</span>
        {% elsif link.kind == "neurips" %}
          <svg class="plate-svg plate-svg-neurips" viewBox="1.5 2.5 21 19" aria-hidden="true">
            <path d="M3 4h18"></path>
            <path d="M4 4v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4"></path>
            <path d="M12 16v4"></path>
            <path d="M9 20h6"></path>
            <path d="M8 12l3-3 2 2 3-3"></path>
          </svg>
          <span>{{ link.label }}</span>
        {% elsif link.kind == "github" %}
          <svg class="plate-svg plate-svg-github" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
          </svg>
          <span>{{ link.label }}</span>
        {% elsif link.kind == "x" %}
          <i class="fa-brands fa-square-x-twitter" aria-hidden="true"></i>
        {% else %}
          <span>{{ link.label }}</span>
        {% endif %}
      </a>
    </li>
  {% endfor %}
</ul>
